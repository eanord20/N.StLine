<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:NStLine.App.Converters"
                    xmlns:loc="clr-namespace:NStLine.App.Services">
    <conv:ActiveMaterialMatchConverter x:Key="ActiveMaterialMatchConverter" />
    <conv:MaterialIdToNameConverter x:Key="MaterialIdToNameConverter" />

    <DataTemplate x:Key="SectionGroupHeaderTemplate">
        <Border Background="{DynamicResource MaterialDesignDivider}" Margin="0,4,0,0">
            <Button Padding="4,2" Height="26" HorizontalContentAlignment="Left"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    Command="{Binding DataContext.SetActiveMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding Name}"
                    ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=TooltipActiveMaterial}">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource MaterialIdToNameConverter}">
                            <Binding Path="Name" />
                            <Binding Path="DataContext.ProjectMaterials" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Button>
        </Border>
    </DataTemplate>

    <Style x:Key="WorkspaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="StaleResultBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ErrorRowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppToolbarButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ExactLimitTextBoxStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedExactProfileKey}" Value="custom">
                <Setter Property="IsReadOnly" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MaterialChipStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Command" Value="{Binding DataContext.SetActiveMaterialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        <Setter Property="CommandParameter" Value="{Binding Id}" />
        <Style.Triggers>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource ActiveMaterialMatchConverter}">
                        <Binding Path="Id" />
                        <Binding Path="DataContext.ActiveMaterialId" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Background" Value="{DynamicResource ActiveSectionBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="24" />
    </Style>
</ResourceDictionary>
