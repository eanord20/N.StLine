<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ErrorRowBrush" Color="#5A2626" />
    <SolidColorBrush x:Key="ActiveSectionBrush" Color="#2A4A63" />
    <SolidColorBrush x:Key="BarPartFillBrush" Color="#448AFF" />
    <SolidColorBrush x:Key="BarRemainderFillBrush" Color="#424242" />
    <SolidColorBrush x:Key="BarPartStrokeBrush" Color="#1976D2" />

    <Thickness x:Key="CardPadding">8</Thickness>
    <Thickness x:Key="SmallMargin">6</Thickness>
    <sys:Double x:Key="DefaultFontSize">13</sys:Double>
    <sys:Double x:Key="DisabledMenuItemOpacity">0.4</sys:Double>
    <SolidColorBrush x:Key="AppCheckBoxCheckedBrush" Color="#448AFF" />
    <SolidColorBrush x:Key="AppCheckBoxGlyphBrush" Color="White" />

    <Color x:Key="AppMenuBackgroundColor">#2C2C2C</Color>
    <Color x:Key="AppMenuForegroundColor">#FFFFFF</Color>
    <Color x:Key="AppInputBackgroundColor">#333333</Color>
    <Color x:Key="AppInputForegroundColor">#FFFFFF</Color>
    <Color x:Key="AppInputDropDownBackgroundColor">#333333</Color>

    <SolidColorBrush x:Key="AppMenuBackgroundBrush" Color="{StaticResource AppMenuBackgroundColor}" />
    <SolidColorBrush x:Key="AppMenuForegroundBrush" Color="{StaticResource AppMenuForegroundColor}" />
    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="{StaticResource AppInputBackgroundColor}" />
    <SolidColorBrush x:Key="AppInputForegroundBrush" Color="{StaticResource AppInputForegroundColor}" />
    <SolidColorBrush x:Key="AppInputDropDownBackgroundBrush" Color="{StaticResource AppInputDropDownBackgroundColor}" />
    <SolidColorBrush x:Key="MaterialDesignBody" Color="{StaticResource AppMenuForegroundColor}" />
    <SolidColorBrush x:Key="MaterialDesignTextBoxBackground" Color="{StaticResource AppInputBackgroundColor}" />
    <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="{StaticResource AppInputBackgroundColor}" />
    <SolidColorBrush x:Key="MaterialDesignDivider" Color="#555555" />

    <SolidColorBrush x:Key="SubMenuBackgroundBrush" Color="{StaticResource AppMenuBackgroundColor}" />
    <SolidColorBrush x:Key="Menu.Static.Background" Color="{StaticResource AppMenuBackgroundColor}" />
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="{StaticResource AppMenuForegroundColor}" />
    <SolidColorBrush x:Key="Menu.Static.Border" Color="{StaticResource AppInputForegroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="{StaticResource AppInputBackgroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="{StaticResource AppInputForegroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Background" Color="{StaticResource AppMenuBackgroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Border" Color="{StaticResource AppInputForegroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="{StaticResource AppInputBackgroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="{StaticResource AppInputForegroundColor}" />

    <Style x:Key="AppButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="30" />
    </Style>

    <Style x:Key="AppIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppMenuBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppMenuForegroundBrush}" />
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource AppMenuBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppMenuForegroundBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource DisabledMenuItemOpacity}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource AppMenuBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppMenuForegroundBrush}" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesignTextBoxBackground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesignBody}" />
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppInputDropDownBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesignTextBoxBackground}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AppInputDropDownBackgroundBrush}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppMaterialComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppInputForegroundBrush}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AppInputDropDownBackgroundBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="AppCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <BulletDecorator>
                        <BulletDecorator.Bullet>
                            <Grid Width="20" Height="20">
                                <Border x:Name="CheckBorder" Width="20" Height="20" Background="Transparent" BorderBrush="{DynamicResource MaterialDesignBody}" BorderThickness="1.5" CornerRadius="2" />
                                <Path x:Name="CheckMark" Data="M 2 10 L 7 15 L 16 4" Stroke="{DynamicResource AppCheckBoxGlyphBrush}" StrokeThickness="2" Stretch="Uniform" Margin="2" Visibility="Collapsed" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AppCheckBoxCheckedBrush}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AppCheckBoxCheckedBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBorder" Property="Opacity" Value="0.4" />
                            <Setter TargetName="CheckMark" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
