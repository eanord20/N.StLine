<Window x:Class="NStLine.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NStLine.App.Services"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutWindowTitle}"
        SizeToContent="WidthAndHeight"
        MinWidth="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Resources/logo.png"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <StackPanel Margin="28" HorizontalAlignment="Center">
        <Image Source="pack://application:,,,/Resources/logo.png" Width="72" Height="72" />
        <TextBlock Text="N.StLine" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.75" />
        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0">
            <Run Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutAuthor, Mode=OneWay}" />
            <Run Text=": Nikolay Sukhomlin" />
        </TextBlock>
        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0">
            <Run Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutContact, Mode=OneWay}" />
            <Run Text=": nik.sukhomlin20@gmail.com" />
        </TextBlock>
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutDescription}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Margin="0,12,0,0" />
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutCopyright}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Margin="0,12,0,0" Opacity="0.75" FontSize="12" />
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutLicense}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Margin="0,2,0,0" Opacity="0.75" FontSize="12" />
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutThirdPartyLibraries}"
                   HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,16,0,0" />
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" Opacity="0.75" FontSize="12">
            <Run Text="DocX 5.0.0" /><LineBreak />
            <Run Text="MaterialDesignThemes 4.9.0" /><LineBreak />
            <Run Text="System.Drawing.Common 8.0.0" />
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonLicense}"
                    MinWidth="90" Margin="0,0,8,0" Click="License_Click" />
            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonOk}"
                    IsDefault="True" MinWidth="90" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
