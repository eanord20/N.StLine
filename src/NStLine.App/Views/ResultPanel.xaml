<UserControl x:Class="NStLine.App.Views.ResultPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:NStLine.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="800">

    <UserControl.Resources>
        <conv:BarPartsSummaryConverter x:Key="BarPartsSummaryConverter" />
    </UserControl.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Method, StringFormat='Method: {0}'}" FontWeight="Bold" />

        <WrapPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="{Binding TotalBarCount, StringFormat='Bars: {0}'}" Margin="0,0,16,0" />
            <TextBlock Text="{Binding TotalPartLength, StringFormat='Part length: {0:F1}'}" Margin="0,0,16,0" />
            <TextBlock Text="{Binding TotalCutLoss, StringFormat='Cut loss: {0:F1}'}" Margin="0,0,16,0" />
            <TextBlock Text="{Binding TotalRemainder, StringFormat='Remainder: {0:F1}'}" Margin="0,0,16,0" />
            <TextBlock Text="{Binding UtilizationPercent, StringFormat='Utilization: {0:F1}%'}" />
        </WrapPanel>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Bars}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                  VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="4,4" />
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                <DataGridTextColumn Header="Cuts" Binding="{Binding CutCount}" Width="50" />
                <DataGridTextColumn Header="Cut loss" Binding="{Binding CutLoss, StringFormat='{}{0:F1}'}" Width="70" />
                <DataGridTemplateColumn Header="Parts" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource BarPartsSummaryConverter}}" VerticalAlignment="Center" Padding="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Remainder" Binding="{Binding Remainder, StringFormat='{}{0:F1}'}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
