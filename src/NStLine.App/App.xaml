<Application x:Class="NStLine.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NStLine.App"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="/NStLine.App;component/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Thickness x:Key="SettingsPadding">16</Thickness>
            <Thickness x:Key="ButtonOutlineThickness">1</Thickness>
            <Thickness x:Key="FieldSpacing">0,8,0,0</Thickness>
            <Thickness x:Key="SectionSpacing">0,16,0,0</Thickness>
            <Thickness x:Key="ActionSpacing">0,0,6,6</Thickness>
            <Thickness x:Key="InlineSpacing">0,0,12,0</Thickness>
            <Thickness x:Key="ToolbarFieldsSpacing">6,0,12,6</Thickness>
            <TranslateTransform x:Key="ToolbarReportInputOffset" Y="-4" />
            <Thickness x:Key="InlineCheckBoxSpacing">0,8,16,0</Thickness>
            <Thickness x:Key="CheckBoxLabelPadding">8,0,0,0</Thickness>
            <sys:Double x:Key="SettingsFontSize">14</sys:Double>
            <sys:Double x:Key="SettingsHeaderFontSize">16</sys:Double>
            <sys:Double x:Key="MaterialActionButtonWidth">90</sys:Double>
            <sys:Double x:Key="SettingsDialogWidth">620</sys:Double>
            <sys:Double x:Key="SettingsDialogMaxHeight">760</sys:Double>
            <sys:Double x:Key="ReportFileNameFieldWidth">230</sys:Double>
            <sys:Double x:Key="ToolbarIconSize">16</sys:Double>
            <sys:Double x:Key="ToolbarControlHeight">30</sys:Double>
            <Thickness x:Key="ToolbarControlPadding">8,3</Thickness>
            <Thickness x:Key="ToolbarIconSpacing">0,0,5,0</Thickness>
            <sys:Double x:Key="MaterialMenuMinWidth">160</sys:Double>
            <Style x:Key="SettingsWindowStyle" TargetType="Window">
                <Setter Property="FontSize" Value="{StaticResource SettingsFontSize}" />
                <Setter Property="Width" Value="{StaticResource SettingsDialogWidth}" />
                <Setter Property="MaxHeight" Value="{StaticResource SettingsDialogMaxHeight}" />
                <Setter Property="SizeToContent" Value="Height" />
                <Setter Property="ResizeMode" Value="CanResize" />
                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesignBody}" />
            </Style>
            <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="{StaticResource FieldSpacing}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBoxStyle}">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="FontSize" Value="{StaticResource SettingsFontSize}" />
                <Setter Property="Padding" Value="{StaticResource CheckBoxLabelPadding}" />
                <Setter Property="Margin" Value="{StaticResource InlineCheckBoxSpacing}" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            </Style>
            <Style x:Key="SettingsGroupBoxStyle" TargetType="GroupBox">
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="{StaticResource SettingsHeaderFontSize}" FontWeight="Bold" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CompactToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource AppToolbarButtonStyle}">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Margin" Value="{StaticResource ActionSpacing}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
